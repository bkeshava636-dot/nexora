# Nexora API server — environment variables
#
# Copy this file to `.env` for local development and fill in real values.
# NEVER commit the real `.env` file — it is already excluded via .gitignore.
# NEVER expose any of these values to the frontend/browser.

# --- Server ---------------------------------------------------------------

# Port the Express server listens on. Required.
PORT=5050

# development | production. Controls: pino-pretty logging vs structured
# JSON, cookie Secure/SameSite behavior (see session.ts), and CORS strictness.
NODE_ENV=development

# Pino log level: trace | debug | info | warn | error | fatal. Optional,
# defaults to "info".
LOG_LEVEL=info

# --- Database ---------------------------------------------------------------

# PostgreSQL connection string used by Drizzle (lib/db). Required.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# For a hosted/production database (e.g. Supabase), use the connection
# string from that provider's dashboard — typically requires ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexora

# --- Authentication ---------------------------------------------------------

# Admin login username. Required.
ADMIN_USERNAME=admin

# Admin password, in ONE of these two forms:
#   - ADMIN_PASSWORD_HASH (preferred for production): a "salt:hash" string
#     produced by hashPassword() in src/lib/password.ts (scrypt-based).
#   - ADMIN_PASSWORD (dev convenience only): plaintext, hashed in memory at
#     request time. Do not use in production — prefer the hash form above.
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD=change-me

# Secret used to sign admin session cookies (HMAC-SHA256). Required.
# Use a long, random, unguessable value — e.g. `openssl rand -hex 32`.
# Rotating this value invalidates all existing admin sessions.
SESSION_SECRET=

# --- CORS ---------------------------------------------------------------

# Comma-separated list of allowed origins for cross-origin requests with
# credentials (cookies), e.g. the deployed frontend's URL. Required in
# production (NODE_ENV=production) — requests from origins not in this list
# are rejected. Ignored in development, where any origin is reflected so the
# local Vite dev server works without extra config.
# Example: CORS_ORIGIN=https://nexora.example.com,https://staging.nexora.example.com
CORS_ORIGIN=
