# Nexora frontend — environment variables
#
# Copy this file to `.env` for local development.
#
# IMPORTANT — frontend-safe only: every `VITE_*` variable below is compiled
# directly into the public JavaScript bundle and is visible to anyone who
# opens the site. Never put secrets, API keys, or database credentials here.
# There is currently no server-only frontend config — this app has no server
# component beyond Vite's dev/build tooling.

# --- Required at runtime (build-time, embedded in the bundle) -------------

# Base URL of the deployed API server (e.g. https://api.nexora.example.com).
# The API server is a separate deployable with its own URL, so requests
# need an explicit origin. Leave unset/empty for same-origin deployments
# (e.g. a reverse proxy that serves both the frontend and /api from one
# host), in which case requests fall back to relative "/api/..." paths.
VITE_API_BASE_URL=

# --- Required by Vite's dev/build tooling (not browser-visible env vars,
#     these configure the Node-side dev server / build, not the app code) --

# Port the Vite dev server listens on. Required in development.
PORT=5173

# Public base path the app is served from (e.g. "/" or "/nexora/").
# Required in development and production builds.
BASE_PATH=/

# --- Optional, local development only --------------------------------------

# When set, the Vite dev server proxies /api/* requests to this URL so the
# browser sees the API as same-origin (simplest way to test the admin
# session cookie locally without cross-origin cookie configuration).
# Not used in production — see VITE_API_BASE_URL above instead.
# Example: VITE_DEV_API_PROXY_TARGET=http://localhost:5050
VITE_DEV_API_PROXY_TARGET=
